{
  "name": "machine-vision-learning-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "predev": "npm run content:build",
    "content:check": "tsx scripts/build-content.ts --check",
    "content:build": "tsx scripts/build-content.ts",
    "prebuild": "npm run content:build",
    "build": "node scripts/run-next.mjs build",
    "pretypecheck": "npm run content:build",
    "typecheck": "node scripts/run-next.mjs typegen && tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run content:build",
    "test": "vitest run",
    "pretest:unit": "npm run content:build",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "serve:static": "node scripts/serve-static.mjs",
    "check": "npm run content:check && npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "check:full": "npm run check && playwright test"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.3",
    "fuse.js": "7.5.0",
    "katex": "0.16.22",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx-frontmatter": "5.2.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "remark-frontmatter": "5.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vfile-matter": "5.0.1",
    "vitest": "4.1.11"
  }
}
